# Шаблон локального конфига: make setup копирует его в .env.
#
# Значение JWT_SECRET годится для разработки и тестов как есть — оно лежит
# в публичном репозитории, поэтому в бою секрет приходит из окружения.
# Сгенерировать своё: openssl rand -hex 32
JWT_SECRET=dev-only-secret-do-not-use-in-production

# Необязательные: значения по умолчанию объявлены в app/settings.py.
#
# По умолчанию база живёт в памяти процесса и пересоздаётся при каждом
# старте, поэтому отдельного сервиса для запуска примера не нужно.
# Постоянное хранение — путь к файлу или адрес postgres.
# DATABASE_URL=sqlite+aiosqlite:///./app.sqlite
# JWT_EXPIRES_IN=3600
# ENVIRONMENT=development
# CORS_ORIGIN=*
# RATE_LIMIT=100/minute
# SCRYPT_COST=16384

# Трассировка включается только при указанном коллекторе.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=python-fastapi-rest-api-example
